  <diagram id="wh-5b8cE1pogqAinVxm0" name="HU-11: Crear reserva">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="IzHKrIUXas_pwdveJt3--1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="2008.6" width="2664" x="6" y="12" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-11-crear-reserva\nautonumber\ntitle HU-11 · Crear reserva\\nPOST /api/v1/reservas · JWT + Rol COMPRADOR\\nLock optimista + Publicador de Eventos\n\nactor \&quot;Comprador\&quot; as U\nparticipant \&quot;JwtAuthenticationFilter\&quot; as F\nparticipant \&quot;ReservaController\&quot; as C\nparticipant \&quot;ReservaServiceImpl\&quot; as S\nparticipant \&quot;ReservaValidator\&quot; as V\ndatabase \&quot;PlatoRepository\&quot; as P\ndatabase \&quot;ReservaRepository\&quot; as R\nparticipant \&quot;PublicadorEventosReserva\&quot; as E\ndatabase \&quot;EventoReservaRepository\&quot; as EV\ndatabase \&quot;PostgreSQL\&quot; as DB\ndatabase \&quot;MongoDB\&quot; as MG\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nU -&gt; F: POST /api/v1/reservas + Bearer JWT\nF -&gt; F: validarToken → SecurityContext\nalt Token inválido\n  F -&gt;[#red] GEH: AuthenticationException\n  GEH --&gt;[#red] U: 401\nelse Token válido\n  F -&gt; C: request\n  C -&gt; C: @PreAuthorize(\&quot;hasRole(&#39;COMPRADOR&#39;)\&quot;)\n  alt Rol insuficiente\n    C -&gt;[#red] GEH: AccessDeniedException\n    GEH --&gt;[#red] U: 403\n  else Rol OK\n    C -&gt; C: @Valid ReservaRequestDTO\n    C -&gt; C: getCuentaId() → compradorId\n    C -&gt; S: crear(compradorId, reserva)\n    S -&gt; P: findById(platoId)\n    P -&gt; DB: SELECT platos\n    DB --&gt; P: PlatoEntity | null\n    alt Plato no existe\n      P -&gt;[#red] GEH: PlatoNoEncontradoException\n      GEH --&gt;[#red] U: 404\n    else Plato existe\n      S -&gt; V: validarParaCrear(comprador, plato, cant, medioPago)\n      alt Cocinera reservando su propio plato\n        V -&gt;[#red] GEH: AutoReservaException\n        GEH --&gt;[#red] U: 422\n      else 2+ reservas PENDIENTES\n        V -&gt;[#red] GEH: LimiteReservasPendientesException\n        GEH --&gt;[#red] U: 409\n      else Sin porciones disponibles\n        V -&gt;[#red] GEH: PorcionesInsuficientesException\n        GEH --&gt;[#red] U: 409\n      else Medio de pago no aceptado\n        V -&gt;[#red] GEH: MedioPagoNoAceptadoException\n        GEH --&gt;[#red] U: 400\n      else OK\n        S -&gt; S: plato.comprometerPorciones(cantidad)\n        S -&gt; P: saveAndFlush(plato)\n        P -&gt; DB: UPDATE platos SET porciones_comprometidas\n        alt Conflicto de versión optimista\n          P -&gt;[#red] GEH: ObjectOptimisticLockingFailureException\n          GEH --&gt;[#red] U: 409 \&quot;El plato fue modificado\&quot;\n        else Actualizado\n          S -&gt; S: Reserva.crear() → PENDIENTE, límite +10 min\n          S -&gt; R: save(ReservaEntity)\n          R -&gt; DB: INSERT reservas\n          S -&gt; EV: save(RESERVA_CREADA)\n          EV -&gt; MG: INSERT eventos_reserva\n          S -&gt; E: publicar(evento)\n          note over E: Observers: auditoría + notificaciones\\nin-app al comprador y cocinera\n          S --&gt; C: Reserva (dominio)\n          C -&gt; S: obtenerConDetalle(id)\n          S --&gt; C: ReservaResponseDTO\n          C --&gt; U: 201 {id, estado:PENDIENTE, monto, plato, conjunto}\n        end\n      end\n    end\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 401 · 403 · 404 · 409 (x3) · 422\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rTBNmrB0ExtNmzO7Rgk7-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

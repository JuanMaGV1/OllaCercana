        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-01-registro\nautonumber\ntitle HU-01 · Registro de cuenta\\nPOST /api/v1/cuentas · Público\n\nactor \&quot;Usuario\&quot; as U\nparticipant \&quot;CuentaController\&quot; as C\nparticipant \&quot;CuentaFactoryRegistry\&quot; as F\nparticipant \&quot;CuentaServiceImpl\&quot; as S\nparticipant \&quot;CuentaValidator\&quot; as V\nparticipant \&quot;PasswordEncoder\&quot; as PE\ndatabase \&quot;CuentaRepository\&quot; as R\ndatabase \&quot;PostgreSQL\&quot; as DB\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nU -&gt; C: POST /api/v1/cuentas\\n{nombre, correo, celular, contrasena, rol}\nC -&gt; C: @Valid RegistroRequestDTO\nalt Input inválido\n  C -&gt;[#red] GEH: MethodArgumentNotValidException\n  GEH --&gt;[#red] U: 400 {detalles: {campo → mensaje}}\nelse Input válido\n  C -&gt; F: crear(request)\n  F -&gt; F: selecciona FabricaComprador / Cocinera / Admin\n  F --&gt; C: Cuenta (dominio)\n  C -&gt; S: registrar(cuenta)\n  S -&gt; V: validarCorreoUnico / validarCelularUnico / validarPasswordSegura\n  alt Correo o celular duplicado\n    V -&gt;[#red] GEH: ConflictoException\n    GEH --&gt;[#red] U: 409 \&quot;El correo ya está registrado\&quot;\n  else Contraseña débil\n    V -&gt;[#red] GEH: ReglaDeNegocioException\n    GEH --&gt;[#red] U: 422 \&quot;La contraseña debe tener 8+ chars, letras y números\&quot;\n  else Validación OK\n    S -&gt; PE: encode(contrasena)\n    PE --&gt; S: hash BCrypt\n    S -&gt; S: cuenta.inicializar() (estado ACTIVO, fecha, avisos)\n    S -&gt; R: save(CuentaEntity)\n    R -&gt; DB: INSERT cuentas / cuenta_roles\n    DB --&gt; R: id generado\n    R --&gt; S: CuentaEntity\n    S --&gt; C: Cuenta (dominio)\n    C --&gt; U: 201 {id, correo, rol, estado:ACTIVO}\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 409 · 422\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Tef4XF9IlCQ99fDDXhYJ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

  <diagram id="4HP9ieyUtHVebNc4Kg97" name="Moderacion(Resolver reporte)">
    <mxGraphModel dx="2678" dy="1533" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="x7EBIX3dnyHss5Juwq0h-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="1762.3" width="2474.87" x="6" y="9" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-19-moderacion\nautonumber\ntitle HU-19 · Resolver reporte (admin)\\nPOST /api/v1/admin/moderacion/reportes/{id}/decision · Rol ADMIN\\nAuditoría obligatoria (RN-23)\n\nactor \&quot;Admin\&quot; as A\nparticipant \&quot;JwtAuthenticationFilter\&quot; as F\nparticipant \&quot;ModeracionController\&quot; as C\nparticipant \&quot;ModeracionServiceImpl\&quot; as S\ndatabase \&quot;ReporteRepository\&quot; as R\ndatabase \&quot;PlatoRepository\&quot; as P\ndatabase \&quot;CuentaRepository\&quot; as CU\ndatabase \&quot;DecisionModeracionRepository\&quot; as D\ndatabase \&quot;NotificacionRepository\&quot; as N\ndatabase \&quot;PostgreSQL\&quot; as DB\ndatabase \&quot;MongoDB\&quot; as MG\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nA -&gt; F: POST /admin/moderacion/reportes/{id}/decision + JWT\nF -&gt; F: validarToken → SecurityContext\nalt Token inválido\n  F -&gt;[#red] GEH: AuthenticationException\n  GEH --&gt;[#red] A: 401\nelse Token válido\n  F -&gt; C: request\n  C -&gt; C: @PreAuthorize(\&quot;hasRole(&#39;ADMIN&#39;)\&quot;)\n  alt No es ADMIN\n    C -&gt;[#red] GEH: AccessDeniedException\n    GEH --&gt;[#red] A: 403 \&quot;No tiene permisos para ver esta sección\&quot;\n  else Es ADMIN\n    C -&gt; C: @Valid EjecutarDecisionDTO\n    alt Decisión o justificación vacía\n      C -&gt;[#red] GEH: MethodArgumentNotValidException\n      GEH --&gt;[#red] A: 400\n    else Input válido\n      C -&gt; C: getCuentaId() → adminId\n      C -&gt; S: resolver(reporteId, dto, adminId)\n      S -&gt; R: findById(reporteId)\n      R -&gt; DB: SELECT reportes\n      DB --&gt; R: entity | null\n      alt Reporte no existe\n        R -&gt;[#red] GEH: ResourceNotFoundException\n        GEH --&gt;[#red] A: 404\n      else Reporte existe\n        S -&gt; D: save(DecisionModeracion) — auditoría RN-23\n        D -&gt; DB: INSERT decisiones_moderacion\n        alt INHABILITAR_PUBLICACION (objetivo PLATO)\n          S -&gt; P: findById(objetivoId)\n          S -&gt; P: save(estado = OCULTO)\n          P -&gt; DB: UPDATE platos\n        else RESTAURAR_PUBLICACION\n          S -&gt; P: findById(objetivoId)\n          S -&gt; P: save(estado = ACTIVO|AGOTADO)\n        else SUSPENDER_CUENTA\n          S -&gt; CU: findById(cuentaObjetivoId)\n          S -&gt; CU: save(estado = SUSPENDIDO)\n          CU -&gt; DB: UPDATE cuentas\n        else DESCARTAR o ADVERTIR\n          note over S: solo queda auditada la decisión\n        end\n        S -&gt; R: save(estado = RESUELTO)\n        R -&gt; DB: UPDATE reportes\n        S -&gt; N: save(Notificación MODERACION_DECISION)\n        N -&gt; MG: INSERT notificaciones\n        S --&gt; C: void\n        C --&gt; A: 200\n      end\n    end\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 401 · 403 · 404\\nMensaje específico de 403 para rutas /api/v1/admin\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hGFR9c8Bma-W72OR5dPM-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

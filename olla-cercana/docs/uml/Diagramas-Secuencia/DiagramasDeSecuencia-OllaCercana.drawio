          <mxGeometry height="1487" width="2443" x="7" y="13" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-13-enviar-mensaje\nautonumber\ntitle HU-13 · Enviar mensaje de chat\\nPOST /api/v1/reservas/{id}/mensajes · Roles COMPRADOR o COCINERA\\nPersistencia MongoDB\n\nactor \&quot;Comprador / Cocinera\&quot; as U\nparticipant \&quot;JwtAuthenticationFilter\&quot; as F\nparticipant \&quot;ChatController\&quot; as C\nparticipant \&quot;ChatServiceImpl\&quot; as S\nparticipant \&quot;ChatValidator\&quot; as V\ndatabase \&quot;ReservaRepository\&quot; as R\ndatabase \&quot;MensajeChatRepository\&quot; as M\nparticipant \&quot;PublicadorEventosReserva\&quot; as E\ndatabase \&quot;PostgreSQL\&quot; as DB\ndatabase \&quot;MongoDB\&quot; as MG\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nU -&gt; F: POST /reservas/{id}/mensajes + JWT\\n{texto: \&quot;...\&quot;}\nF -&gt; F: validarToken → SecurityContext\nalt Token inválido\n  F -&gt;[#red] GEH: AuthenticationException\n  GEH --&gt;[#red] U: 401\nelse Token válido\n  F -&gt; C: request\n  C -&gt; C: @PreAuthorize(\&quot;hasAnyRole(&#39;COMPRADOR&#39;,&#39;COCINERA&#39;)\&quot;)\n  C -&gt; C: @Valid EnviarMensajeRequestDTO\n  C -&gt; C: getCuentaId + getCocineraIdOpt\n  C -&gt; S: enviar(reservaId, request)\n  S -&gt; V: validarParaEnviarMensaje(id, cuentaId, cocineraId, texto)\n  V -&gt; R: findById(reservaId)\n  R -&gt; DB: SELECT reservas\n  DB --&gt; R: entity | null\n  alt Reserva no existe\n    V -&gt;[#red] GEH: ReservaNoEncontradaException\n    GEH --&gt;[#red] U: 404\n  else Usuario ajeno a la reserva\n    V -&gt;[#red] GEH: AccesoDenegadoException\n    GEH --&gt;[#red] U: 403\n  else Chat no ACTIVO\n    V -&gt;[#red] GEH: ConflictoException(\&quot;Chat finalizado\&quot;)\n    GEH --&gt;[#red] U: 409\n  else Texto vacío o &gt; 500 chars\n    V -&gt;[#red] GEH: IllegalArgumentException\n    GEH --&gt;[#red] U: 400\n  else OK\n    S -&gt; S: construir MensajeChatDocument (rol, autorId, fecha)\n    S -&gt; M: save(document)\n    M -&gt; MG: INSERT mensajes_chat\n    MG --&gt; M: doc con id\n    S -&gt; E: publicar(NUEVO_MENSAJE_CHAT)\n    note over E: Observers notifican al receptor\\ny registran auditoría\n    S --&gt; C: MensajeResponseDTO\n    C --&gt; U: 201 {id, autor, texto, fecha, leido:false}\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 401 · 403 · 404 · 409\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AsObGoLPqPR_s09UqB35-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />

  <diagram id="V4QzhnoTX5aQx9dONwZq" name="HU-06 + HU-07: ConsultarPlatosCercanos">
    <mxGraphModel dx="2219" dy="1288" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="y_np_dc4PSzpAqBjPta8-57" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="1226" width="2010" x="10" y="14" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-06-platos-cercanos\nautonumber\ntitle HU-06 + HU-07 · Consultar platos cercanos\\nGET /api/v1/platos/cercanos · Público · RN-05\n\nactor \&quot;Usuario anónimo\&quot; as U\nparticipant \&quot;PlatoController\&quot; as C\nparticipant \&quot;PlatoServiceImpl\&quot; as S\nparticipant \&quot;FiltroCompuestoPlato\&quot; as FI\nparticipant \&quot;GeoUtils\&quot; as G\ndatabase \&quot;PlatoRepository\&quot; as R\ndatabase \&quot;PerfilCocineraRepository\&quot; as PR\ndatabase \&quot;PostgreSQL\&quot; as DB\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nU -&gt; C: GET /platos/cercanos\\n?lat&amp;lng&amp;radio&amp;tipoComida&amp;restricciones\nnote over C: Ruta pública — permitAll() en SecurityConfig\nC -&gt; C: @Valid ConsultaPlatosRequest (lat/lng requeridos)\nalt Lat/lng faltantes o fuera de rango\n  C -&gt;[#red] GEH: MethodArgumentNotValidException\n  GEH --&gt;[#red] U: 400\nelse Input válido\n  C -&gt; S: consultarCercanos(request)\n  S -&gt; S: normalizarRadio(500–2000 m)\n  S -&gt; R: buscarCercanosConDistancia(lat, lng, radio, tipo)\n  R -&gt; DB: SELECT ... fórmula Haversine ORDER BY distancia\n  DB --&gt; R: Page&lt;Object[]&gt; (entity, distancia)\n  R --&gt; S: filas paginadas\n  S -&gt; S: entity → dominio\n  S -&gt; FI: agregar FiltroRestricciones (si hay)\n  loop por cada plato\n    S -&gt; FI: cumple(plato)\n    FI --&gt; S: true / false\n  end\n  S -&gt; G: calcularDistanciaEnMetros + redondear100m\n  S -&gt; G: formatearTiempoRestante(fechaExpiracion)\n  S -&gt; PR: findById(cocineraId)\n  PR -&gt; DB: SELECT perfiles_cocinera\n  DB --&gt; PR: perfil\n  PR --&gt; S: conjuntoResidencial\n  S -&gt; S: ordenar por distanciaAproximada ASC\n  S --&gt; C: PaginaResponseDTO&lt;PlatoCercanoResponseDTO&gt;\n  C --&gt; U: 200 {contenido:[...], page, size, totalElementos, hayMas}\nend\n\nnote over C,GEH: Errores cubiertos: 400 · (ruta pública: sin 401/403)\\nNo expone puntoEntrega (RN-05)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="y_np_dc4PSzpAqBjPta8-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

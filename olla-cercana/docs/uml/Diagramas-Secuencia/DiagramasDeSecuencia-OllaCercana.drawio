  <diagram id="4YyIMoIIq0PnMbJZEtgR" name="Actualizar disponibilidad de plato">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c47jvadKI7J73W521Luu-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="1821" width="2585" x="5" y="9" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-24-ajustar-disponibilidad\nautonumber\ntitle HU-24 · Ajustar disponibilidad de plato\\nPATCH /api/v1/platos/{id}/disponibilidad · Rol COCINERA\\nLock optimista (@Version) + SSE de porciones\n\nactor \&quot;Cocinera\&quot; as C1\nparticipant \&quot;JwtAuthenticationFilter\&quot; as F\nparticipant \&quot;PlatoController\&quot; as C\nparticipant \&quot;PlatoServiceImpl\&quot; as S\nparticipant \&quot;PlatoValidator\&quot; as V\nparticipant \&quot;UsuarioActual\&quot; as UAC\ndatabase \&quot;PlatoRepository\&quot; as R\nparticipant \&quot;PublicadorEventosPorciones\&quot; as E\ndatabase \&quot;PostgreSQL\&quot; as DB\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nC1 -&gt; F: PATCH /platos/{id}/disponibilidad + JWT\\n{tipo, cantidad, version}\nF -&gt; F: validarToken → SecurityContext\nalt Token inválido\n  F -&gt;[#red] GEH: AuthenticationException\n  GEH --&gt;[#red] C1: 401\nelse Token válido\n  F -&gt; C: request\n  C -&gt; C: @PreAuthorize(\&quot;hasRole(&#39;COCINERA&#39;)\&quot;)\n  C -&gt; C: @Valid AjusteDisponibilidadRequest\n  alt Falta versión o cantidad inválida\n    C -&gt;[#red] GEH: MethodArgumentNotValidException\n    GEH --&gt;[#red] C1: 400\n  else Input válido\n    C -&gt; S: obtenerPorId(platoId)\n    S -&gt; R: findById\n    R -&gt; DB: SELECT platos\n    DB --&gt; R: entity\n    alt Plato no existe\n      R -&gt;[#red] GEH: PlatoNoEncontradoException\n      GEH --&gt;[#red] C1: 404\n    else Cocinera no es la dueña\n      C -&gt; UAC: getCocineraId()\n      C -&gt;[#red] GEH: AccesoDenegadoException\n      GEH --&gt;[#red] C1: 403\n    else Autorizado\n      C -&gt; S: ajustarDisponibilidad(id, tipo, cant, version)\n      S -&gt; V: validarAjusteDisponibilidad(plato, tipo, cant)\n      alt Plato EXPIRADO\n        V -&gt;[#red] GEH: PlatoExpiradoException\n        GEH --&gt;[#red] C1: 422\n      else Cantidad &lt;= 0 (no MARCAR_AGOTADO)\n        V -&gt;[#red] GEH: CantidadAjusteInvalidaException\n        GEH --&gt;[#red] C1: 422\n      else Reducción por debajo de comprometidas\n        V -&gt;[#red] GEH: ReduccionPorDebajoDeComprometidasException\n        GEH --&gt;[#red] C1: 409\n      else OK\n        S -&gt; S: plato.ajustarDisponibilidad(tipo, cant) + setVersion\n        S -&gt; R: saveAndFlush(entity)\n        R -&gt; DB: UPDATE platos WHERE id=? AND version=?\n        alt Conflicto de versión\n          R -&gt;[#red] GEH: ObjectOptimisticLockingFailureException\n          GEH --&gt;[#red] C1: 409 \&quot;El plato fue modificado, refresca la página\&quot;\n        else Actualizado\n          S -&gt; E: publicarSiCambio(disponiblesAntes, plato)\n          note over E: SSE / observers actualizan\\nclientes suscritos al plato\n          S --&gt; C: Plato (dominio)\n          C --&gt; C1: 200 {porcionesTotales, estado, version}\n        end\n      end\n    end\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 401 · 403 · 404 · 409 (x2) · 422\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pTKe7fL4xmssgz8Q86RC-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="pl_0" plantUmlBaseStyle="shape=umlLifeline;perimeter=lifelinePerimeter;participant=none;size=57;lifelineMirror=1;dashPattern=5 5;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=none;strokeColor=#181818;strokeWidth=0.5;" plantUmlBaseValue="" id="pTKe7fL4xmssgz8Q86RC-2">
          <mxCell parent="pTKe7fL4xmssgz8Q86RC-1" style="shape=umlLifeline;perimeter=lifelinePerimeter;participant=none;size=57;lifelineMirror=1;dashPattern=5 5;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=none;strokeColor=#181818;strokeWidth=0.5;" vertex="1">

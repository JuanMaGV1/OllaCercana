  <diagram id="bKEC23lqf7XPCk487VCp" name="HU-12: Decidir reserva">
    <mxGraphModel dx="2640" dy="1533" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ZvkAlgfQ68cpJMWoxvME-104" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="1992" width="1924" x="16" y="12" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-12-decidir-reserva\nautonumber\ntitle HU-12 · Decidir reserva\\nPATCH /api/v1/reservas/{id}/decision · Rol COCINERA\\nMáquina de estados protegida\n\nactor \&quot;Cocinera\&quot; as C1\nparticipant \&quot;JwtAuthenticationFilter\&quot; as F\nparticipant \&quot;ReservaController\&quot; as C\nparticipant \&quot;ReservaServiceImpl\&quot; as S\ndatabase \&quot;ReservaRepository\&quot; as R\ndatabase \&quot;PlatoRepository\&quot; as P\nparticipant \&quot;PublicadorEventosReserva\&quot; as E\ndatabase \&quot;PostgreSQL\&quot; as DB\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nC1 -&gt; F: PATCH /reservas/{id}/decision + JWT\\n{decision: CONFIRMAR|RECHAZAR, ...}\nF -&gt; F: validarToken → SecurityContext\nalt Token inválido\n  F -&gt;[#red] GEH: AuthenticationException\n  GEH --&gt;[#red] C1: 401\nelse Token válido\n  F -&gt; C: request\n  C -&gt; C: @PreAuthorize(\&quot;hasRole(&#39;COCINERA&#39;)\&quot;)\n  C -&gt; C: @Valid DecisionReservaRequestDTO\n  alt Falta hora (CONFIRMAR) o motivo (RECHAZAR)\n    C -&gt;[#red] GEH: MethodArgumentNotValidException\n    GEH --&gt;[#red] C1: 400\n  else DTO válido\n    C -&gt; C: getCocineraId()\n    C -&gt; S: decidir(id, cocineraId, request)\n    S -&gt; R: findById(reservaId)\n    R -&gt; DB: SELECT reservas\n    DB --&gt; R: entity | null\n    alt Reserva no existe\n      R -&gt;[#red] GEH: ReservaNoEncontradaException\n      GEH --&gt;[#red] C1: 404\n    else Reserva de otra cocinera\n      S -&gt;[#red] GEH: AccesoDenegadoException\n      GEH --&gt;[#red] C1: 403\n    else Reserva propia\n      alt decision = CONFIRMAR\n        S -&gt; S: reserva.confirmar(horaEstimada, ahora)\n        alt estado != PENDIENTE\n          S -&gt;[#red] GEH: ReservaNoPendienteException\n          GEH --&gt;[#red] C1: 409\n        else Pasaron los 10 min\n          S -&gt;[#red] GEH: ReservaVencidaException\n          GEH --&gt;[#red] C1: 409\n        else Hora inválida o nula\n          S -&gt;[#red] GEH: DecisionReservaInvalidaException\n          GEH --&gt;[#red] C1: 422\n        else OK → CONFIRMADA, chat ACTIVO\n          S -&gt; R: save(reserva)\n          R -&gt; DB: UPDATE reservas\n          S -&gt; E: publicar(RESERVA_CONFIRMADA, horaEstimada)\n        end\n      else decision = RECHAZAR\n        S -&gt; S: reserva.rechazar(motivo, comentario, ahora)\n        alt motivo OTRO sin comentario\n          S -&gt;[#red] GEH: DecisionReservaInvalidaException\n          GEH --&gt;[#red] C1: 422\n        else Comentario &gt; 150 chars\n          S -&gt;[#red] GEH: DecisionReservaInvalidaException\n          GEH --&gt;[#red] C1: 422\n        else OK\n          S -&gt; P: findById(platoId) → liberarPorciones\n          P -&gt; DB: UPDATE platos\n          S -&gt; R: save(reserva RECHAZADA)\n          S -&gt; E: publicar(RESERVA_RECHAZADA, motivo, comentario)\n        end\n      end\n      S --&gt; C: Reserva (dominio)\n      C --&gt; C1: 200 {id, estado, chatHabilitado, motivoRechazo?}\n    end\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 401 · 403 · 404 · 409 (x2) · 422 (x3)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZvkAlgfQ68cpJMWoxvME-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

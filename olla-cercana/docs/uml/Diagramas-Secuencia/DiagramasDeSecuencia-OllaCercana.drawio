  <diagram id="i_DE9-_2kpp0tz-zQxCU" name="HU-15 + HU-22: Calificar reserva">
    <mxGraphModel dx="2678" dy="1533" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2ptE_iTZtpXZBrET4EQ-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="1960" width="2273" x="7" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-15-calificar-reserva\nautonumber\ntitle HU-15 + HU-22 · Calificar reserva\\nPOST /api/v1/reservas/{reservaId}/calificacion · Rol COMPRADOR\\nCascada de reputación (RN-09)\n\nactor \&quot;Comprador\&quot; as U\nparticipant \&quot;JwtAuthenticationFilter\&quot; as F\nparticipant \&quot;CalificacionController\&quot; as C\nparticipant \&quot;CalificacionServiceImpl\&quot; as S\ndatabase \&quot;ReservaRepository\&quot; as R\ndatabase \&quot;CalificacionRepository\&quot; as CR\ndatabase \&quot;PerfilCocineraRepository\&quot; as PR\nparticipant \&quot;EvaluadorReputacionCalificacion\&quot; as ER\ndatabase \&quot;PostgreSQL\&quot; as DB\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nU -&gt; F: POST /reservas/{id}/calificacion + JWT\\n{estrellas: 1-5, comentario?}\nF -&gt; F: validarToken → SecurityContext\nalt Token inválido\n  F -&gt;[#red] GEH: AuthenticationException\n  GEH --&gt;[#red] U: 401\nelse Token válido\n  F -&gt; C: request\n  C -&gt; C: @PreAuthorize(\&quot;hasRole(&#39;COMPRADOR&#39;)\&quot;)\n  C -&gt; C: @Valid CalificacionRequestDTO\n  alt Estrellas fuera de 1-5\n    C -&gt;[#red] GEH: MethodArgumentNotValidException\n    GEH --&gt;[#red] U: 400\n  else Input válido\n    C -&gt; C: getCuentaId() → compradorId\n    C -&gt; S: calificar(reservaId, compradorId, request)\n    S -&gt; R: findById(reservaId)\n    R -&gt; DB: SELECT reservas\n    DB --&gt; R: entity | null\n    alt Reserva no existe\n      R -&gt;[#red] GEH: ReservaNoEncontradaException\n      GEH --&gt;[#red] U: 404\n    else Comprador ajeno a la reserva\n      S -&gt;[#red] GEH: AccesoDenegadoCalificacionException\n      GEH --&gt;[#red] U: 403\n    else Reserva no COMPLETADA\n      S -&gt;[#red] GEH: ReservaNoCompletadaException\n      GEH --&gt;[#red] U: 422\n    else Ya fue calificada\n      S -&gt;[#red] GEH: CalificacionDuplicadaException\n      GEH --&gt;[#red] U: 409\n    else OK\n      S -&gt; S: nueva Calificacion (PENDIENTE, límite +72h)\n      S -&gt; CR: save(entity)\n      CR -&gt; DB: INSERT calificaciones\n      S -&gt; CR: findByReservaIdAndCompradorIdNot (contraparte)\n      alt Contraparte ya calificó\n        S -&gt; S: publicar AMBAS (RN-20)\n        S -&gt; CR: save x2 (estado PUBLICADA)\n      else Contraparte aún no\n        note over S: queda PENDIENTE — scheduler\\nla publicará a las 72h (RN-19)\n      end\n      S -&gt; CR: promedioPorCocinera + contarPositivas\n      CR -&gt; DB: SELECT AVG(estrellas), COUNT(*)\n      S -&gt; PR: findById(cocineraId)\n      PR --&gt; S: perfil\n      S -&gt; PR: save(promedio, resenasPositivas, esDestacada)\n      PR -&gt; DB: UPDATE perfiles_cocinera\n      S -&gt; ER: evaluar(cocineraId)\n      alt Promedio &lt; 3.5 y ≥5 reseñas\n        ER -&gt; PR: pausar perfil (RN-09)\n      end\n      S --&gt; C: CalificacionResponseDTO\n      C --&gt; U: 201 {id, estado, estrellas, comentario, fechaCreacion}\n    end\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 401 · 403 · 404 · 409 · 422\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n40B0xv8p1uwaLDFEhS1-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="pl_0" plantUmlBaseStyle="shape=umlLifeline;perimeter=lifelinePerimeter;participant=none;size=57;lifelineMirror=1;dashPattern=5 5;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=none;strokeColor=#181818;strokeWidth=0.5;" plantUmlBaseValue="" id="n40B0xv8p1uwaLDFEhS1-2">

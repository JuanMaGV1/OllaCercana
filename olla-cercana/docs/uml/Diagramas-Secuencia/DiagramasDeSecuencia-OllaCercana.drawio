  <diagram id="IIlTeviB1Bvyu2C65y1f" name="HU-04: Publicar plato">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="RaiE8q4o4mOpT0iIf_Ds-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="1713.1" width="2910" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-04-publicar-plato\nautonumber\ntitle HU-04 · Publicar plato\\nPOST /api/v1/platos · JWT + Rol COCINERA\\nCadena de validación: CocineraHabilitada → Precio → LimitePlatos\n\nactor \&quot;Cocinera\&quot; as C1\nparticipant \&quot;JwtAuthenticationFilter\&quot; as F\nparticipant \&quot;PlatoController\&quot; as C\nparticipant \&quot;UsuarioActual\&quot; as UAC\nparticipant \&quot;PlatoServiceImpl\&quot; as S\nparticipant \&quot;PlatoValidator\&quot; as V\nparticipant \&quot;CocineraHabilitadaHandler\&quot; as VH\nparticipant \&quot;PrecioPlatoHandler\&quot; as VP\nparticipant \&quot;LimitePlatosActivosHandler\&quot; as VL\ndatabase \&quot;PlatoRepository\&quot; as R\ndatabase \&quot;PostgreSQL\&quot; as DB\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nC1 -&gt; F: POST /api/v1/platos + Bearer JWT\nF -&gt; F: validarToken(jwt)\nalt Token inválido o ausente\n  F -&gt;[#red] GEH: AuthenticationException\n  GEH --&gt;[#red] C1: 401\nelse Token válido\n  F -&gt; C: request autorizado (SecurityContext)\n  C -&gt; C: @PreAuthorize(\&quot;hasRole(&#39;COCINERA&#39;)\&quot;)\n  alt Rol insuficiente\n    C -&gt;[#red] GEH: AccessDeniedException\n    GEH --&gt;[#red] C1: 403\n  else Rol OK\n    C -&gt; C: @Valid PlatoRequestDTO\n    alt DTO inválido\n      C -&gt;[#red] GEH: MethodArgumentNotValidException\n      GEH --&gt;[#red] C1: 400\n    else DTO válido\n      C -&gt; UAC: getCocineraId()\n      UAC --&gt; C: UUID cocinera\n      C -&gt; S: crear(plato con cocineraId)\n      S -&gt; V: validarParaPublicar(plato)\n      V -&gt; VH: validar(plato)\n      alt Sin cocinera / no verificada / pausada\n        VH -&gt;[#red] GEH: CocineraNoVerificada / Pausada / PlatoSinCocinera\n        GEH --&gt;[#red] C1: 409\n      else Cocinera habilitada\n        VH -&gt; VP: validar(plato)\n        alt Precio &lt; 2000 o &gt; 50000\n          VP -&gt;[#red] GEH: PrecioFueraDeRangoException\n          GEH --&gt;[#red] C1: 422\n        else Precio no múltiplo de 100\n          VP -&gt;[#red] GEH: PrecioNoMultiploException\n          GEH --&gt;[#red] C1: 422\n        else Precio OK\n          VP -&gt; VL: validar(plato)\n          alt 3+ platos activos vigentes\n            VL -&gt;[#red] GEH: LimitePlatosActivosExcedidoException\n            GEH --&gt;[#red] C1: 409\n          else Cupo disponible\n            S -&gt; S: plato.publicar() → ACTIVO, expira +4h\n            S -&gt; R: save(PlatoEntity)\n            R -&gt; DB: INSERT platos / plato_restricciones\n            DB --&gt; R: entity\n            R --&gt; S: PlatoEntity\n            S --&gt; C: Plato (dominio)\n            C --&gt; C1: 201 {id, estado:ACTIVO, porcionesDisponibles, ...}\n          end\n        end\n      end\n    end\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 401 · 403 · 409 · 422\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XXid5sH5lXL5rFHCTROm-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

          <mxGeometry height="1180" width="1800" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-02-login\nautonumber\ntitle HU-02 · Inicio de sesión\\nPOST /api/v1/sesiones · Público\n\nactor \&quot;Usuario\&quot; as U\nparticipant \&quot;SesionController\&quot; as C\nparticipant \&quot;CuentaServiceImpl\&quot; as S\nparticipant \&quot;PasswordEncoder\&quot; as PE\nparticipant \&quot;JwtService\&quot; as J\ndatabase \&quot;CuentaRepository\&quot; as R\ndatabase \&quot;PerfilCocineraRepository\&quot; as PR\ndatabase \&quot;PostgreSQL\&quot; as DB\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nU -&gt; C: POST /api/v1/sesiones\\n{identificador, contrasena}\nC -&gt; C: @Valid LoginRequestDTO\nalt Campos vacíos\n  C -&gt;[#red] GEH: MethodArgumentNotValidException\n  GEH --&gt;[#red] U: 400\nelse Input válido\n  C -&gt; S: autenticar(identificador, contrasena)\n  S -&gt; R: findByIdentificador(correo o celular)\n  R -&gt; DB: SELECT cuentas WHERE correo=:id OR celular=:id\n  DB --&gt; R: CuentaEntity | null\n  alt Cuenta no existe\n    S -&gt;[#red] GEH: BadCredentialsException\n    GEH --&gt;[#red] U: 401 \&quot;Credenciales inválidas\&quot;\n  else Cuenta BLOQUEADA\n    S -&gt;[#red] GEH: LockedException\n    GEH --&gt;[#red] U: 401 \&quot;La cuenta se encuentra bloqueada\&quot;\n  else Contraseña incorrecta\n    S -&gt; PE: matches(raw, hash)\n    PE --&gt; S: false\n    S -&gt;[#red] GEH: BadCredentialsException\n    GEH --&gt;[#red] U: 401\n  else OK\n    S --&gt; C: Cuenta (dominio)\n    C -&gt; J: generarToken(cuenta)\n    J -&gt; PR: findByCuentaId(id)\n    PR --&gt; J: PerfilCocinera | empty\n    note over J: Claims: correo, roles, cuentaId,&lt;br/&gt;cocineraId · HS256 · expira 24h\n    J --&gt; C: JWT firmado\n    C --&gt; U: 200 {token, id, nombre, correo, rol, roles}\n  end\nend\n\nnote over C,GEH: Errores cubiertos: 400 · 401 (BadCredentials / Locked)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="sQJWEBNryI917QC2a8DP-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

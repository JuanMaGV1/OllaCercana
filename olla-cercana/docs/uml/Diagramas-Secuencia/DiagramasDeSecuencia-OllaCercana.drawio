  <diagram id="y30Ls62vP7sIKQn6IVE_" name="HU-09: Mapa Cocineras">
    <mxGraphModel dx="2219" dy="1288" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ZCHS8L1WwXeoC53jwVNv-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="" vertex="1">
          <mxGeometry height="1200" width="2010" x="10" y="20" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml HU-09-mapa-cocineras\nautonumber\ntitle HU-09 · Mapa de cocineras con oferta activa\\nGET /api/v1/cocineras/mapa · Público · RN-05 (ofuscación)\n\nactor \&quot;Usuario anónimo\&quot; as U\nparticipant \&quot;CocineraMapaController\&quot; as C\nparticipant \&quot;CocineraMapaServiceImpl\&quot; as S\nparticipant \&quot;GeoUtils\&quot; as G\ndatabase \&quot;PlatoRepository\&quot; as R\ndatabase \&quot;PerfilCocineraRepository\&quot; as PR\ndatabase \&quot;PostgreSQL\&quot; as DB\nparticipant \&quot;GlobalExceptionHandler\&quot; as GEH\n\nU -&gt; C: GET /cocineras/mapa?latitud&amp;longitud&amp;radio\nnote over C: Ruta pública\nC -&gt; C: @Valid MapaCocinerasRequestDTO\nalt Lat/lng fuera de rango o radio &gt; 50km\n  C -&gt;[#red] GEH: MethodArgumentNotValidException\n  GEH --&gt;[#red] U: 400\nelse Input válido\n  C -&gt; S: buscarCocinerasEnMapa(request)\n  S -&gt; R: findActivosVigentes(ACTIVO, ahora)\n  R -&gt; DB: SELECT platos estado=ACTIVO AND no expirado AND porciones&gt;0\n  DB --&gt; R: List&lt;PlatoEntity&gt;\n  R --&gt; S: platos\n  loop cada plato con coordenadas\n    S -&gt; G: calcularDistanciaEnMetros(usuario, plato)\n    alt distancia &lt;= radio\n      S -&gt; S: agrupar por cocineraId (mejor oferta)\n    end\n  end\n  loop cada cocinera candidata\n    S -&gt; G: redondearDistanciaMultiplo100(distanciaReal)\n    S -&gt; G: ofuscarCoordenadas(cocineraId, salt, lat, lng)\n    note over G: LCG determinístico → desplaza 100–300 m\\nMismo ID siempre da mismo resultado (RN-05)\n    S -&gt; PR: findById(cocineraId)\n    PR -&gt; DB: SELECT perfiles_cocinera\n    DB --&gt; PR: perfil\n    PR --&gt; S: nombre / conjunto\n  end\n  S -&gt; S: ordenar por distanciaMetros ASC\n  S --&gt; C: List&lt;CocineraMapaResponseDTO&gt;\n  C --&gt; U: 200 [{cocineraId, latOfuscada, lngOfuscada, distanciaMetros, ...}]\nend\n\nnote over C,GEH: Errores cubiertos: 400 (validación del DTO)\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Lm7bN9DSpMpeInP4AcNX-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
